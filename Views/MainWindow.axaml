<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SPL.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
        x:Class="SPL.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SPL - Simple Programming Language"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        xmlns:AvaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.7"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, 1*, Auto, 35, 200, Auto, 250" Background="#0D1117">
        
        <!-- 1. Header with Toolbar -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <!-- Logo/Title -->
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="▶" Foreground="#58A6FF" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="SPL Interpreter" Foreground="#C9D1D9" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="v1.0" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
                <!-- Center Spacer -->
                <Border Grid.Column="1"/>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="Info" Content="ℹ️ Info" Background="#5964F3" Foreground="White"
                            Padding="12,8" CornerRadius="6"
                            ToolTip.Tip="Zeigt Versions- und Anwendungsinformationen an"/>
                    <Button Name="Run" Content="▶ Ausführen" Background="#238636" Foreground="White" 
                            Padding="16,8" CornerRadius="6" Click="Run_Click"
                            ToolTip.Tip="Drücke Ctrl+Enter zum Ausführen"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Editor Section -->
        <Border Grid.Row="1" Background="#0D1117" Margin="0" CornerRadius="0">
            <Grid RowDefinitions="Auto, *">
                <!-- Editor Label -->
                <Border Background="#161B22" Padding="16,10" BorderBrush="#30363D" BorderThickness="0,0,0,1">
                    <TextBlock Text="📝 Code Editor" FontSize="13" Foreground="#8B949E" FontWeight="SemiBold"/>
                </Border>
                
                <!-- Editor -->
                <AvaloniaEdit:TextEditor Grid.Row="1" Name="Editor" ShowLineNumbers="True" 
                                        FontFamily="'Cascadia Code','Consolas','Monospace'" FontSize="14" 
                                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" 
                                        Background="#0D1117" Foreground="#C9D1D9" Margin="0"
                                        LineNumbersForeground="#30363D"/>
            </Grid>
        </Border>

        <!-- 3. Input Section Header -->
        <Border Grid.Row="2" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,1" Padding="16,10">
            <TextBlock Text="⌨️  Eingabe" FontSize="13" Foreground="#8B949E" FontWeight="SemiBold"/>
        </Border>

        <!-- 4. Input Field -->
        <TextBox Grid.Row="3" Name="InputField" Background="#0D1117" Foreground="#C9D1D9" 
                BorderBrush="#30363D" Padding="12,8" Margin="0" 
                BorderThickness="0" FontSize="13"
                PlaceholderText="Geben Sie Eingaben hier ein..."
                ToolTip.Tip="Hier können Sie Text eingeben, wenn das Programm mit 'eingabe' wartet"/>

        <!-- 5. Output Section -->
        <Grid Grid.Row="4" RowDefinitions="Auto, *" Background="#0D1117">
            <!-- Output Header -->
            <Border Background="#161B22" Padding="16,10" BorderBrush="#30363D" BorderThickness="0,1,0,1">
                <TextBlock Text="📋 Konsole / Ausgabe" FontSize="13" Foreground="#8B949E" FontWeight="SemiBold"/>
            </Border>
            
            <!-- Output -->
            <AvaloniaEdit:TextEditor Grid.Row="1" Name="Output" IsReadOnly="True" ShowLineNumbers="False" 
                                    Background="#010409" Foreground="#79C0FF" 
                                    FontFamily="'Cascadia Code','Monospace'" FontSize="12" 
                                    HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible"
                                    Margin="0"/>
        </Grid>

        <!-- 6. Graphics Section Header -->
        <Border Grid.Row="5" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,1" Padding="16,10">
            <TextBlock Text="🎨 Grafik / Zeichnung" FontSize="13" Foreground="#8B949E" FontWeight="SemiBold"/>
        </Border>

        <!-- 7. Canvas for Drawing -->
        <Canvas Grid.Row="6" Name="DrawingCanvas" Background="#1C2128" Margin="0"/>
    </Grid>
</Window>
